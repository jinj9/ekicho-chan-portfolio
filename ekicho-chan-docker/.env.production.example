# Copy this file to .env.production on EC2. Never commit the real file.

# Pin these to tested image tags or digests before the production launch.
POSTGRES_IMAGE='postgres:17'
SPRING_IMAGE='000000000000.dkr.ecr.ap-northeast-1.amazonaws.com/ekicho-chan-spring:REPLACE_WITH_RELEASE_TAG'

# Generate independent, long random passwords. Do not reuse local credentials.
POSTGRES_PASSWORD='REPLACE_WITH_RANDOM_POSTGRES_ADMIN_PASSWORD'
SPRING_DB_PASSWORD='REPLACE_WITH_RANDOM_APPLICATION_DB_PASSWORD'

# Production SMTP settings (for example, Amazon SES SMTP credentials).
MAIL_HOST='REPLACE_WITH_SMTP_HOST'
MAIL_PORT='587'
MAIL_USERNAME='REPLACE_WITH_SMTP_USERNAME'
MAIL_PASSWORD='REPLACE_WITH_SMTP_PASSWORD'
MAIL_FROM='no-reply@ekichochan.com'

CORS_ALLOWED_ORIGINS='https://ekichochan.com'

# Configure the same value as a CloudFront custom origin header named X-Origin-Verify.
ORIGIN_VERIFY_SECRET='REPLACE_WITH_LONG_RANDOM_ORIGIN_SECRET'
