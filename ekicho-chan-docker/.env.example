# Local development only. Replace with your own admin password.
# Single quotes keep characters such as $ literal in Compose .env files.
POSTGRES_PASSWORD='REPLACE_WITH_LOCAL_ADMIN_PASSWORD'

# Password of the ekicho1 application user created by init/01_ekicho_chan_init_db.sql.
SPRING_DB_PASSWORD='REPLACE_WITH_LOCAL_APPLICATION_PASSWORD'

# Docker Spring Boot API (defaults shown below).
# SPRING_BIND_ADDRESS='127.0.0.1'
SPRING_BIND_ADDRESS='0.0.0.0'
SPRING_PORT='18080'
CORS_ALLOWED_ORIGINS='http://localhost:3000,http://127.0.0.1:3000'
