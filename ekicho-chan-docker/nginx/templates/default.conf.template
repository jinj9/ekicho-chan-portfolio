## CloudFront appends the actual viewer address to the end of X-Forwarded-For.
## Use that final address as the per-client key; direct/local calls fall back to remote_addr.
map $http_x_forwarded_for $rate_limit_client_ip {
    ""      $remote_addr;
    ~^(?:.*?,\s*)*(?<last_forwarded_address>[^,\s]+)\s*$ $last_forwarded_address;
}

## An empty key is not counted, so the stricter zones only apply to matching endpoints.
map $uri $auth_rate_limit_key {
    default "";
    ~^/api/v1/(?:web/)?auth/ $rate_limit_client_ip;
}

map $uri $portfolio_expensive_rate_limit_key {
    default "";
    ~^/api/v1/portfolio/stations/(?:gacha|location-get)$ $rate_limit_client_ip;
}

limit_req_zone $rate_limit_client_ip zone=api_per_client:10m rate=10r/s;
limit_req_zone $server_name zone=api_per_server:1m rate=100r/s;
limit_req_zone $auth_rate_limit_key zone=auth_per_client:10m rate=10r/m;
limit_req_zone $portfolio_expensive_rate_limit_key zone=portfolio_expensive_per_client:10m rate=30r/m;

server {
    listen 80;
    server_name _;
    server_tokens off;
    limit_req_status 429;
    limit_req_log_level warn;
    error_page 429 = @rate_limit_exceeded;

    location @rate_limit_exceeded {
        default_type application/json;
        add_header Retry-After 60 always;
        add_header Cache-Control "no-store" always;
        return 429 '{"code":"RATE_LIMIT_EXCEEDED","message":"しばらく待ってから再実行してください。"}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        if ($http_x_origin_verify != "${ORIGIN_VERIFY_SECRET}") {
            return 403;
        }

        # General origin protection plus stricter limits for costly and authentication endpoints.
        limit_req zone=api_per_client burst=30 nodelay;
        limit_req zone=api_per_server burst=200 nodelay;
        limit_req zone=auth_per_client burst=5 nodelay;
        limit_req zone=portfolio_expensive_per_client burst=8 nodelay;

        proxy_pass http://spring:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $rate_limit_client_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        client_max_body_size 10m;
    }

    location / {
        return 404;
    }
}
